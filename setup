#!/bin/sh
# Moda skills installer.
# Copies the skill directories into the harness locations it can detect and
# PRINTS the pinned moda-CLI install command. It never installs the CLI,
# never pipes curl to sh, never uses sudo.
set -eu
cd "$(dirname "$0")"

SKILLS="moda-core moda-help moda-deck moda-deck-pptx moda-document moda-document-print moda-one-pager moda-social moda-social-instagram moda-social-linkedin moda-social-tiktok moda-social-youtube moda-social-ads moda-diagram moda-chart moda-mockup moda-website moda-video moda-video-clip moda-video-motion moda-image moda-audio moda-brand moda-edit moda-library moda-templates moda-context moda-automate"
installed=""

copy_into() {
  dest="$1"
  mkdir -p "$dest"
  for s in $SKILLS; do
    rm -rf "$dest/$s"
    cp -R "skills/$s" "$dest/$s"
  done
  installed="$installed $dest"
}

# Codex and other SKILL.md-native harnesses
if [ -d "$HOME/.agents" ] || command -v codex >/dev/null 2>&1; then
  copy_into "$HOME/.agents/skills"
fi

# Claude Code personal skills dir (plugin marketplace is the preferred path)
if [ -d "$HOME/.claude" ]; then
  copy_into "$HOME/.claude/skills"
fi

# Cursor
if [ -d "$HOME/.cursor" ]; then
  copy_into "$HOME/.cursor/skills"
fi

if [ -z "$installed" ]; then
  copy_into "$HOME/.agents/skills"
fi

echo "Skills installed to:$installed"
echo
echo "Claude Code users: prefer the marketplace instead of this copy:"
echo "  /plugin marketplace add moda-design/moda && /plugin install moda@moda"
echo

# Release artifacts are named moda-<platform>-<arch> with Node/Bun platform-arch
# spelling (moda-linux-x64, moda-darwin-arm64, ...) plus a SHA256SUMS file —
# see scripts/build.ts and scripts/release.ts. Map uname output accordingly.
# This script only runs under a POSIX shell, so "Windows" here means Git Bash /
# MSYS2 / Cygwin, where uname reports MINGW64_NT-… and the artifact is suffixed.
PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64) ARCH=x64 ;;
  aarch64|arm64) ARCH=arm64 ;;
esac
case "$PLATFORM" in
  mingw*|msys*|cygwin*) PLATFORM=win32 ;;
esac

if command -v moda >/dev/null 2>&1; then
  echo "moda CLI found: $(command -v moda)"
elif [ "$PLATFORM" = win32 ]; then
  echo "Now install the moda CLI yourself (this script never will). On Windows the"
  echo "npm package is the supported path — it pulls the win32-x64 binary:"
  echo
  echo "  npm i -g @moda-design/moda"
  echo
  echo "Standalone alternative: download moda-win32-x64.exe from the release and put"
  echo "it on PATH as moda.exe:"
  echo
  echo "  gh release download --repo moda-design/moda -p moda-win32-x64.exe -D ."
  echo
  echo "Then run: moda doctor"
else
  echo "Now install the moda CLI yourself (this script never will). Pinned command"
  echo "(needs the gh CLI, authenticated):"
  echo
  echo "  gh release download --repo moda-design/moda -p moda-${PLATFORM}-${ARCH} -O ~/.local/bin/moda && chmod +x ~/.local/bin/moda"
  echo
  echo "To verify checksums first, use the download flow in INSTALL.md section 2."
  echo "Then run: moda doctor"
fi
